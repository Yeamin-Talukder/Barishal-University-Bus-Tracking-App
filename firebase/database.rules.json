{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && $uid !== auth.uid",
        ".validate": "newData.isBoolean() && newData.val() === true"
      }
    },

    "busDrivers": {
      ".read": "auth != null",
      "$busId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
      }
    },

    "activeTrips": {
      ".read": true,
      ".indexOn": ["driverUid"],
      "$busId": {
        ".write": "auth != null && (root.child('busDrivers').child($busId).val() === auth.uid || (!newData.exists() && root.child('admins').child(auth.uid).val() === true))",
        ".validate": "newData.hasChildren(['tripId', 'driverUid', 'status', 'startedAt'])",
        "tripId": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
        },
        "driverUid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "status": {
          ".validate": "newData.val() === 'active'"
        },
        "startedAt": {
          ".validate": "newData.val() === now"
        },
        "routeId": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "liveLocations": {
      ".read": true,
      "$busId": {
        ".write": "auth != null && ((root.child('busDrivers').child($busId).val() === auth.uid && (!newData.exists() || (root.child('activeTrips').child($busId).child('status').val() === 'active' && root.child('activeTrips').child($busId).child('driverUid').val() === auth.uid && (!data.exists() || now - data.child('updatedAt').val() >= 1000)))) || (!newData.exists() && root.child('admins').child(auth.uid).val() === true))",
        ".validate": "newData.hasChildren(['tripId', 'driverUid', 'latitude', 'longitude', 'updatedAt'])",
        "tripId": {
          ".validate": "newData.isString() && newData.val() === root.child('activeTrips').child($busId).child('tripId').val()"
        },
        "driverUid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "latitude": {
          ".validate": "newData.isNumber() && newData.val() >= 20.5 && newData.val() <= 26.7"
        },
        "longitude": {
          ".validate": "newData.isNumber() && newData.val() >= 88.0 && newData.val() <= 92.7"
        },
        "heading": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 360"
        },
        "speed": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 60"
        },
        "accuracy": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
        },
        "updatedAt": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
