<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget, small: the next buses take turns, sliding up, each
     led by the bus's name. A green dot in the corner while buses on these
     routes are sharing their position. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:padding="12dp">

    <ViewFlipper
        android:id="@+id/flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="5000"
        android:inAnimation="@anim/widget_flip_in"
        android:outAnimation="@anim/widget_flip_out" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textColor="@color/widget_muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/live_pill"
        android:layout_width="9dp"
        android:layout_height="9dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="5dp"
        android:contentDescription="Buses live now"
        android:src="@drawable/widget_dot"
        android:tint="@color/widget_live"
        android:visibility="gone" />
</FrameLayout>
