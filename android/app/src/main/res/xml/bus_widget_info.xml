<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget: resizable from 2x2 (small) to wider (medium).
     Each widget has its own settings: Android 12+ places it straight away
     and offers Settings on long-press; older versions ask when it is added. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="bd.ac.bu.bu_bus_tracker.WidgetConfigActivity"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_bus_medium"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:previewLayout="@layout/widget_bus_medium"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
